diff --git a/style.scss b/style.scss
new file mode 100644
index 0000000..c2e168b
--- /dev/null
+++ b/style.scss
@@ -0,0 +1,108 @@
+:root {
+  --primary-bg-color: #000;
+  --secondary-bg-color: #333;
+}
+
+* {
+  margin: 0;
+  padding: 0;
+  box-sizing: border-box;
+  font-family: Montserrat;
+  font-weight: 400;
+  line-height: 100%;
+  letter-spacing: 5%;
+  vertical-align: middle;
+}
+
+.header {
+  &-top {
+    display: flex;
+    justify-content: space-around;
+    align-items: center;
+    background-color: black;
+    color: white;
+    width: 100%;
+    height: 30px;
+    font-size: 13px;
+
+    &__item {
+      gap: 10px;
+      cursor: pointer;
+
+      &:last-child {
+        cursor: initial;
+      }
+    }
+
+    &__icon {
+      height: 16px;
+    }
+
+    &__cta {
+      background: none;
+      color: inherit;
+      border: none;
+      padding: 0;
+      font: inherit;
+      cursor: pointer;
+      outline: inherit;
+    }
+  }
+
+  &-bottom {
+    display: flex;
+    align-items: center;
+    height: 100px;
+    background-color: #f0f0f0;
+
+    &__item {
+      width: 100%;
+      padding: 0 50px;
+    }
+
+    &__logo {
+      height: 25px;
+      width: 372px;
+    }
+  }
+
+  &-search {
+    width: 100%;
+    height: 30px;
+    background-color: #d3d3d3;
+    border: 0px;
+    border-radius: 5px;
+    text-align: center;
+    font-size: 18px;
+    letter-spacing: 15%;
+
+    &__wrapper {
+      position: relative;
+
+      &::before {
+        position: absolute;
+        content: url("/public/icons/magnifier.png");
+        background-color: #c4c4c4;
+        width: 20px;
+        height: 20px;
+        border-radius: 5px 0 0 5px;
+        padding: 5px;
+      }
+    }
+  }
+
+  &-profile {
+    display: flex;
+    align-items: center;
+    justify-content: flex-end;
+    gap: 30px;
+
+    &__item {
+      cursor: pointer;
+    }
+
+    &__icon {
+      height: 30px;
+    }
+  }
+}
